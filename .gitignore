# Ignore underscore folders (scratch folders...)
_*/

# Private data folders, if one is ever created at the repo root (the real data folder lives outside the repo)
/config/
/inputs/
/backups/

# Dot-folders to ignore (everything else under .claude/ is tracked)
.venv/
.next/
.claude/settings.local.json

# Ignore CSV and JSON files in root directory
/*.csv
/*.json
/*.db
/*.db-journal

# Python artefacts
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
